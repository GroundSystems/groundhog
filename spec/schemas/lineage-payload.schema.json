{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundhog.dev/spec/v1/schemas/lineage-payload.schema.json",
  "title": "Groundhog successor lineage payload",
  "type": "object",
  "required": ["v", "predecessor_source", "predecessor_final_frontier"],
  "properties": {
    "v": {
      "const": 1
    },
    "predecessor_source": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_.-]*$",
      "not": {
        "const": "system"
      }
    },
    "predecessor_final_frontier": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false
}
