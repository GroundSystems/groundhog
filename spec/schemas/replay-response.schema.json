{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundhog.dev/spec/v1/schemas/replay-response.schema.json",
  "title": "Groundhog finite replay response",
  "type": "object",
  "required": ["events", "next_after", "snapshot_through_event_id"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      }
    },
    "last_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "next_after": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_through_event_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
