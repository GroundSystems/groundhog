{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundhog.dev/spec/v1/schemas/retirement-response.schema.json",
  "title": "Groundhog source retirement response",
  "type": "object",
  "required": ["v", "status", "source", "final_frontier", "retirement_event_id"],
  "properties": {
    "v": {
      "const": 1
    },
    "status": {
      "enum": ["retired", "already_retired"]
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_.-]*$"
    },
    "final_frontier": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "retirement_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false
}
