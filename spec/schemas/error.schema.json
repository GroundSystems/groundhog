{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundhog.dev/spec/v1/schemas/error.schema.json",
  "title": "Groundhog HTTP error",
  "type": "object",
  "required": ["error", "message"],
  "properties": {
    "error": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "code", "message"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
