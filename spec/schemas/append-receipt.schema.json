{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundhog.dev/spec/v1/schemas/append-receipt.schema.json",
  "title": "Groundhog append receipt",
  "type": "object",
  "required": [
    "status",
    "batch_digest",
    "events",
    "first_event_id",
    "last_event_id"
  ],
  "properties": {
    "status": {
      "enum": ["committed", "duplicate"]
    },
    "batch_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "events": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "first_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "last_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": false
}
