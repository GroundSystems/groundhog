{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundhog.dev/spec/v1/schemas/retirement-request.schema.json",
  "title": "Groundhog source retirement request",
  "type": "object",
  "required": ["source"],
  "properties": {
    "v": {
      "const": 1,
      "default": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_.-]*$",
      "not": {
        "const": "system"
      }
    }
  },
  "additionalProperties": false
}
