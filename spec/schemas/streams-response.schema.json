{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundhog.dev/spec/v1/schemas/streams-response.schema.json",
  "title": "Groundhog stream enumeration response",
  "type": "object",
  "required": ["v", "streams", "next_after", "snapshot_through_event_id"],
  "properties": {
    "v": {
      "const": 1
    },
    "streams": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["source", "stream", "frontier_event_id", "event_count"],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9_][a-z0-9_.-]*$"
          },
          "stream": {
            "type": "string",
            "pattern": "^[a-z0-9_][a-z0-9_.-]*$"
          },
          "frontier_event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "event_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "next_after": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_.-]*/[a-z0-9_][a-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_through_event_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
