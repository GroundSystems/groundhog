#!/usr/bin/env bash
set -euo pipefail

readonly op_version="2.38.1"
readonly op_archive_sha256="7a7b7168f521d31838f0cc59abf172527853308c9b9cceee34895121acb0be0f"
readonly op_vault="Buildkite Pipelines"

fail() {
  echo "with-1password: $*" >&2
  exit 1
}

install_op() {
  if command -v op >/dev/null 2>&1; then
    return
  fi

  [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "x86_64" ]] || \
    fail "automatic 1Password CLI installation supports Linux x86_64 only"

  command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required"

  local install_dir archive url
  install_dir="$(mktemp -d "${TMPDIR:-/tmp}/buildkite-op.XXXXXX")"
  archive="${install_dir}/op.zip"
  url="https://cache.agilebits.com/dist/1P/op2/pkg/v${op_version}/op_linux_amd64_v${op_version}.zip"

  if command -v curl >/dev/null 2>&1; then
    curl --fail --silent --show-error --location --output "${archive}" "${url}"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
      "${url}" "${archive}"
  else
    fail "curl or python3 is required"
  fi

  printf '%s  %s\n' "${op_archive_sha256}" "${archive}" | sha256sum --check --status || \
    fail "the 1Password CLI archive checksum is invalid"

  if command -v unzip >/dev/null 2>&1; then
    unzip -qq "${archive}" op -d "${install_dir}"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -m zipfile -e "${archive}" "${install_dir}"
  else
    fail "unzip or python3 is required"
  fi

  chmod 0700 "${install_dir}/op"
  export PATH="${install_dir}:${PATH}"
}

(( $# >= 3 )) || fail "usage: with-1password ITEM [NAME=FIELD ...] -- COMMAND [ARG ...]"

readonly item="$1"
shift

declare -a mappings=()
while (( $# > 0 )) && [[ "$1" != "--" ]]; do
  mappings+=("$1")
  shift
done

(( $# >= 2 )) && [[ "$1" == "--" ]] || \
  fail "usage: with-1password ITEM [NAME=FIELD ...] -- COMMAND [ARG ...]"
shift

: "${OP_SERVICE_ACCOUNT_TOKEN:?OP_SERVICE_ACCOUNT_TOKEN is required}"
install_op

for mapping in "${mappings[@]}"; do
  [[ "${mapping}" =~ ^[A-Za-z_][A-Za-z0-9_]*=[^=]+$ ]] || \
    fail "invalid environment mapping: ${mapping}"

  name="${mapping%%=*}"
  field="${mapping#*=}"
  value="$(op read "op://${op_vault}/${item}/${field}")"
  [[ -n "${value}" ]] || fail "the ${item}/${field} field is empty"

  if command -v buildkite-agent >/dev/null 2>&1; then
    printf '%s\n' "${value}" | buildkite-agent redactor add
  fi

  printf -v "${name}" '%s' "${value}"
  export "${name}"
  unset value
done

exec "$@"
