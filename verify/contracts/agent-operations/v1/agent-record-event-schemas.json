{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.groundhog.so/agent-record/events/v1",
  "title": "Agent Record event payload schemas version 1",
  "contract_version": 1,
  "compatibility": "additive_optional_fields_only",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "event_ids": {
      "type": "array",
      "maxItems": 65536,
      "items": {"$ref": "#/$defs/event_id"}
    },
    "common": {
      "type": "object",
      "required": ["dataset_id", "workspace_id", "demo_session_id"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/id"},
        "demo_session_id": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "step_id": {"$ref": "#/$defs/id"},
        "tool_call_id": {"$ref": "#/$defs/id"},
        "principal_id": {"$ref": "#/$defs/id"},
        "client_id": {"$ref": "#/$defs/id"},
        "client_request_id": {"$ref": "#/$defs/id"},
        "call_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "provider": {"$ref": "#/$defs/id"},
        "connection_id": {"$ref": "#/$defs/id"},
        "operation": {"$ref": "#/$defs/id"},
        "operation_version": {"$ref": "#/$defs/id"},
        "caused_by_event_id": {"$ref": "#/$defs/event_id"},
        "parent_event_id": {"$ref": "#/$defs/event_id"},
        "source_event_ids": {"$ref": "#/$defs/event_ids"}
      }
    },
    "sessions": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["session_id"],
          "properties": {
            "session_id": {"$ref": "#/$defs/id"},
            "status": {"enum": ["started", "completed"]},
            "started_at": {"$ref": "#/$defs/timestamp"},
            "completed_at": {"$ref": "#/$defs/timestamp"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runs": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["session_id", "run_id", "status"],
          "properties": {
            "session_id": {"$ref": "#/$defs/id"},
            "run_id": {"$ref": "#/$defs/id"},
            "status": {"enum": ["running", "waiting_for_approval", "resumed", "completed", "failed"]},
            "started_at": {"$ref": "#/$defs/timestamp"},
            "completed_at": {"$ref": "#/$defs/timestamp"},
            "outcome": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "messages": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["session_id", "run_id", "message_id", "role", "content"],
          "properties": {
            "session_id": {"$ref": "#/$defs/id"},
            "run_id": {"$ref": "#/$defs/id"},
            "message_id": {"$ref": "#/$defs/id"},
            "role": {"enum": ["user", "assistant", "system"]},
            "content": {"type": "string", "maxLength": 1048576}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "context": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["session_id", "run_id", "scope_id", "projection_receipt", "selected_memory_keys", "evidence_event_ids"],
          "properties": {
            "session_id": {"$ref": "#/$defs/id"},
            "run_id": {"$ref": "#/$defs/id"},
            "scope_id": {"$ref": "#/$defs/id"},
            "projection_receipt": {"type": "object"},
            "selected_memory_keys": {"type": "array", "items": {"type": "string"}},
            "evidence_event_ids": {"$ref": "#/$defs/event_ids"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "model_calls": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["session_id", "run_id", "model_call_id", "model", "state"],
          "properties": {
            "session_id": {"$ref": "#/$defs/id"},
            "run_id": {"$ref": "#/$defs/id"},
            "model_call_id": {"$ref": "#/$defs/id"},
            "model": {"$ref": "#/$defs/id"},
            "state": {"enum": ["requested", "responded", "failed"]},
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "duration_ms": {"type": "integer", "minimum": 0},
            "error": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "tool_calls": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["session_id", "run_id", "tool_call_id", "tool_name", "state"],
          "properties": {
            "session_id": {"$ref": "#/$defs/id"},
            "run_id": {"$ref": "#/$defs/id"},
            "tool_call_id": {"$ref": "#/$defs/id"},
            "tool_name": {"$ref": "#/$defs/id"},
            "call_id": {"$ref": "#/$defs/id"},
            "state": {"enum": ["requested", "completed", "failed"]},
            "arguments": true,
            "result": true,
            "duration_ms": {"type": "integer", "minimum": 0},
            "error": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "controls": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["run_id", "control_id", "control", "state"],
          "properties": {
            "run_id": {"$ref": "#/$defs/id"},
            "control_id": {"$ref": "#/$defs/id"},
            "control": {"enum": ["pause", "resume", "cancel", "retry"]},
            "state": {"enum": ["requested", "applied", "rejected"]},
            "reason": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "calls": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["principal_id", "client_id", "client_request_id", "call_id", "provider", "connection_id", "operation", "operation_version", "mode", "request_hash", "state"],
          "properties": {
            "principal_id": {"$ref": "#/$defs/id"},
            "client_id": {"$ref": "#/$defs/id"},
            "client_request_id": {"$ref": "#/$defs/id"},
            "call_id": {"$ref": "#/$defs/id"},
            "provider": {"$ref": "#/$defs/id"},
            "connection_id": {"$ref": "#/$defs/id"},
            "operation": {"$ref": "#/$defs/id"},
            "operation_version": {"$ref": "#/$defs/id"},
            "mode": {"enum": ["read", "write", "control"]},
            "arguments": true,
            "precondition": true,
            "registry_hash": {"$ref": "#/$defs/hash"},
            "operation_manifest_hash": {"$ref": "#/$defs/hash"},
            "request_hash": {"$ref": "#/$defs/hash"},
            "provider_idempotency_key": {"type": "string"},
            "risk": {"enum": ["low", "medium", "high"]},
            "policy_version": {"type": "string"},
            "action_hash": {"$ref": "#/$defs/hash"},
            "state": {"enum": ["requested", "authorized", "refused", "cancel_requested"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "policies": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "policy_result", "policy_version"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "policy_result": {"enum": ["allowed", "denied", "approval_required"]},
            "policy_version": {"type": "string"},
            "risk": {"enum": ["low", "medium", "high"]},
            "reason": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "approvals": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "approval_id", "state"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "approval_id": {"$ref": "#/$defs/id"},
            "state": {"enum": ["requested", "claimed", "released", "approved", "denied", "edited", "expired"]},
            "actor_id": {"$ref": "#/$defs/id"},
            "expires_at": {"$ref": "#/$defs/timestamp"},
            "edited_arguments": true,
            "reason": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "actions": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "action_hash", "state"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "action_hash": {"$ref": "#/$defs/hash"},
            "state": {"enum": ["proposed", "superseded", "resolved"]},
            "arguments": true,
            "superseded_by_action_hash": {"$ref": "#/$defs/hash"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dispatch": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "state"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "attempt_id": {"$ref": "#/$defs/id"},
            "state": {"enum": ["ready", "claimed", "retry_requested", "retry_scheduled", "reconciliation_requested"]},
            "claim_id": {"$ref": "#/$defs/id"},
            "retry_number": {"type": "integer", "minimum": 0},
            "scheduled_at": {"$ref": "#/$defs/timestamp"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "attempts": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "attempt_id", "state"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "attempt_id": {"$ref": "#/$defs/id"},
            "state": {"enum": ["started", "transmission_started", "finished"]},
            "started_at": {"$ref": "#/$defs/timestamp"},
            "finished_at": {"$ref": "#/$defs/timestamp"},
            "transport_outcome": {"enum": ["responded", "failed", "outcome_unknown"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "api_calls": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "attempt_id", "provider", "operation", "state"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "attempt_id": {"$ref": "#/$defs/id"},
            "provider": {"$ref": "#/$defs/id"},
            "operation": {"$ref": "#/$defs/id"},
            "state": {"enum": ["requested", "responded", "transport_failed"]},
            "provider_request_id": {"$ref": "#/$defs/id"},
            "request": true,
            "response": true,
            "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
            "duration_ms": {"type": "integer", "minimum": 0},
            "error": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "observations": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "provider", "resource_type", "resource_id", "state"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "provider": {"$ref": "#/$defs/id"},
            "resource_type": {"$ref": "#/$defs/id"},
            "resource_id": {"$ref": "#/$defs/id"},
            "remote_revision": {"type": "string"},
            "state": {"enum": ["observed", "observation_failed"]},
            "resource": true,
            "error": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "resolutions": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["call_id", "provider", "operation", "resolution"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "attempt_id": {"$ref": "#/$defs/id"},
            "provider": {"$ref": "#/$defs/id"},
            "operation": {"$ref": "#/$defs/id"},
            "adapter_version": {"type": "string"},
            "resolution": {"enum": ["succeeded", "confirmed_no_effect", "outcome_unknown", "needs_intervention"]},
            "provider_request_id": {"$ref": "#/$defs/id"},
            "provider_idempotency_key": {"type": "string"},
            "remote_revision": {"type": "string"},
            "result_fingerprint": {"$ref": "#/$defs/hash"},
            "response": true,
            "evidence_event_ids": {"$ref": "#/$defs/event_ids"},
            "error": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "memory": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["scope_id", "subject", "key", "transition", "extractor_version", "evidence_event_ids"],
          "properties": {
            "scope_id": {"$ref": "#/$defs/id"},
            "subject": {"$ref": "#/$defs/id"},
            "key": {"$ref": "#/$defs/id"},
            "transition": {"enum": ["proposed", "accepted", "corrected", "superseded", "retracted"]},
            "value": true,
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "extractor_version": {"type": "string"},
            "evidence_event_ids": {"$ref": "#/$defs/event_ids"},
            "evidence_classes": {"type": "array", "items": {"enum": ["successful_call", "failed_call", "retried_call", "message", "observation", "evaluation"]}},
            "supersedes_event_id": {"$ref": "#/$defs/event_id"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evaluations": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["evaluation_id", "run_id", "evaluator", "evaluator_version", "state"],
          "properties": {
            "evaluation_id": {"$ref": "#/$defs/id"},
            "run_id": {"$ref": "#/$defs/id"},
            "evaluator": {"$ref": "#/$defs/id"},
            "evaluator_version": {"type": "string"},
            "state": {"enum": ["scored", "flagged"]},
            "score": {"type": "number"},
            "passed": {"type": "boolean"},
            "flags": {"type": "array", "items": {"type": "string"}},
            "evidence_event_ids": {"$ref": "#/$defs/event_ids"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "projections": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["projection_name", "projection_version", "state"],
          "properties": {
            "projection_name": {"$ref": "#/$defs/id"},
            "projection_version": {"type": "integer", "minimum": 1},
            "state": {"enum": ["rebuild_started", "rebuild_published", "rebuild_failed"]},
            "frontier_event_id": {"$ref": "#/$defs/event_id"},
            "frontier_event_count": {"type": "integer", "minimum": 0},
            "logical_state_hash": {"$ref": "#/$defs/hash"},
            "row_count": {"type": "integer", "minimum": 0},
            "error": {"type": "string"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
