{
  "v": 1,
  "consistency": {
    "mode": "published"
  },
  "query": {
    "relation": "groundhog.events",
    "select": [
      "event_id",
      "source",
      "stream",
      "kind",
      "observed_at"
    ],
    "filter": {
      "op": "eq",
      "field": "source",
      "value": "stripe"
    },
    "order_by": [
      {
        "field": "event_id",
        "direction": "asc"
      }
    ],
    "limit": 100
  }
}
